NODE_ENV=development
PORT=5000

# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/textile_db?schema=public"
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=textile_db
DB_PORT=5432

# Security
JWT_SECRET="your-super-secret-jwt-key-must-be-long-16chars-min"

# Logging
LOG_LEVEL=debug