// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// USER & RBAC MODELS
// -----------------------------------------------------------------------------

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  department   String?        // e.g. SPINNING, WEAVING, DYEING, WAREHOUSE
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  roles           UserRole[]
  refreshSessions RefreshSession[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique // e.g., 'inventory.read', 'users.manage'
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// INVENTORY MODELS
// -----------------------------------------------------------------------------

enum ItemType {
  RAW_MATERIAL
  WORK_IN_PROGRESS
  FINISHED_GOOD
  CONSUMABLE
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     Item[]
  batches   InventoryBatch[]
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances  InventoryBalance[]
  movements StockMovement[]
  alerts    LowStockAlert[]
}

model Item {
  id            String   @id @default(uuid())
  sku           String   @unique
  name          String
  description   String?
  type          ItemType
  materialType  String?  // Yarn type etc.
  colour        String?
  unitOfMeasure String   // e.g., 'kg', 'meters', 'pieces'
  minStock      Decimal  @db.Decimal(10, 2) @default(0.00)
  isActive      Boolean  @default(true)
  
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  balances      InventoryBalance[]
  movements     StockMovement[]
  batches       InventoryBatch[]
  reservations  MaterialReservation[]
  alerts        LowStockAlert[]
}

model InventoryBatch {
  id                  String   @id @default(uuid())
  itemId              String
  internalBatchNumber String   @unique
  supplierBatchNumber String?
  supplierId          String?
  manufactureDate     DateTime?
  expiryDate          DateTime?
  
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  
  createdAt   DateTime  @default(now())
  
  balances    InventoryBalance[]
  movements   StockMovement[]
}

model InventoryBalance {
  id               String   @id @default(uuid())
  itemId           String
  warehouseId      String
  batchId          String?
  
  quantity         Decimal  @db.Decimal(12, 2) @default(0.00) // Physical quantity
  reservedQuantity Decimal  @db.Decimal(12, 2) @default(0.00) // Reserved for production
  
  item        Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batch       InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  
  updatedAt   DateTime  @updatedAt
}

enum MovementType {
  RECEIPT
  CONSUMPTION
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  ISSUE
  ADJUSTMENT
}

model StockMovement {
  id              String       @id @default(uuid())
  itemId          String
  warehouseId     String?
  batchId         String?
  type            MovementType
  
  quantity        Decimal      @db.Decimal(12, 2)
  previousBalance Decimal      @db.Decimal(12, 2)
  newBalance      Decimal      @db.Decimal(12, 2)
  
  referenceId     String?      
  reason          String?
  
  item            Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse       Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batch           InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  
  createdBy       String       
  createdAt       DateTime     @default(now())
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  CANCELLED
  EXPIRED
}

model MaterialReservation {
  id               String            @id @default(uuid())
  itemId           String
  warehouseId      String
  productionJobId  String            // Reference to production order
  status           ReservationStatus @default(ACTIVE)
  
  quantity         Decimal           @db.Decimal(12, 2)
  
  item             Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model LowStockAlert {
  id          String      @id @default(uuid())
  itemId      String
  warehouseId String?
  status      AlertStatus @default(ACTIVE)
  
  shortage    Decimal     @db.Decimal(12, 2)
  
  item        Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
