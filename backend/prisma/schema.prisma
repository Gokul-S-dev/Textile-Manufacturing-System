// Textile Manufacturing Management System (TMMS) Master Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. AUTHENTICATION & ACCESS (FR-12)
// ============================================================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  department   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles                  UserRole[]
  refreshSessions        RefreshSession[]
  auditLogs              AuditLog[]
  ProductionDelay        ProductionDelay[]
  InspectionRecord       InspectionRecord[]
  ReworkRecord           ReworkRecord[]
  CAPARecord             CAPARecord[]
  fgReceipts             FinishedGoodsReceipt[]
  transfersRequested     WarehouseTransfer[]
  createdCounts          StockCount[]            @relation("CountCreator")
  approvedCounts         StockCount[]            @relation("CountApprover")
  assignedPickLists      PickList[]              @relation("PickListAssignee")
  packings               PackingRecord[]         @relation("PackingOperator")
  shipments              Shipment[]              @relation("ShipmentOperator")
  createdInvoices        Invoice[]               @relation("InvoiceCreator")
  approvedInvoices       Invoice[]               @relation("InvoiceApprover")
  recordedPayments       Payment[]               @relation("PaymentRecorder")
  createdCreditNotes     CreditNote[]            @relation("CreditCreator")
  approvedCreditNotes    CreditNote[]            @relation("CreditApprover")
  notifications          Notification[]          @relation("UserNotifications")
  notificationPreference NotificationPreference? @relation("UserNotificationPreferences")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ============================================================================
// 2. PURCHASING & SUPPLIERS (FR-08)
// ============================================================================
model Supplier {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          Item[]
  batches        InventoryBatch[]
  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]
}

enum POStatus {
  DRAFT
  ISSUED
  PARTIAL
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  poNumber    String   @unique
  supplierId  String
  status      POStatus @default(DRAFT)
  totalAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    POItem[]
  receipts GoodsReceipt[]
  invoices SupplierInvoice[]
}

model POItem {
  id        String  @id @default(uuid())
  poId      String
  itemId    String
  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
}

model GoodsReceipt {
  id           String   @id @default(uuid())
  grnNumber    String   @unique
  poId         String
  receivedDate DateTime @default(now())
  invoiceRef   String?

  purchaseOrder    PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Restrict)
  InspectionRecord InspectionRecord[]
}

// ============================================================================
// 3. INVENTORY & RAW MATERIALS (FR-01, FR-06)
// ============================================================================
enum ItemType {
  RAW_MATERIAL
  WORK_IN_PROGRESS
  FINISHED_GOOD
  CONSUMABLE
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances        InventoryBalance[]
  movements       StockMovement[]
  alerts          LowStockAlert[]
  locations       WarehouseLocation[]
  fgReceipts      FinishedGoodsReceipt[]
  sourceTransfers WarehouseTransfer[]    @relation("SourceWh")
  destTransfers   WarehouseTransfer[]    @relation("DestWh")
  stockCounts     StockCount[]
}

model Item {
  id            String   @id @default(uuid())
  sku           String   @unique
  name          String
  description   String?
  type          ItemType
  materialType  String?
  colour        String?
  unitOfMeasure String
  minStock      Decimal  @default(0.00) @db.Decimal(10, 2)
  isActive      Boolean  @default(true)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances         InventoryBalance[]
  movements        StockMovement[]
  batches          InventoryBatch[]
  reservations     MaterialReservation[]
  alerts           LowStockAlert[]
  poItems          POItem[]
  MaterialShortage MaterialShortage[]
  receipts         FinishedGoodsReceipt[]
  transfers        WarehouseTransfer[]
  countItems       StockCountItem[]
  fgReservations   FinishedGoodsReservation[]
  orderLines       CustomerOrderLine[]
  pickItems        PickListItem[]
  invoiceLines     InvoiceLine[]
}

model InventoryBatch {
  id                  String    @id @default(uuid())
  itemId              String
  internalBatchNumber String    @unique
  supplierBatchNumber String?
  supplierId          String?
  manufactureDate     DateTime?
  expiryDate          DateTime?

  item     Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())

  balances     InventoryBalance[]
  movements    StockMovement[]
  consumptions MaterialConsumption[]
  transfers    WarehouseTransfer[]
}

model InventoryBalance {
  id          String  @id @default(uuid())
  itemId      String
  warehouseId String
  locationId  String?
  batchId     String?

  quantity         Decimal @default(0.00) @db.Decimal(12, 2)
  reservedQuantity Decimal @default(0.00) @db.Decimal(12, 2)

  status String @default("AVAILABLE") // AVAILABLE, QUALITY_HOLD, DAMAGED, QUARANTINED, IN_TRANSIT, DISPATCHED

  item      Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location  WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batch     InventoryBatch?    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  updatedAt DateTime @updatedAt
}

enum MovementType {
  RECEIPT
  CONSUMPTION
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  ISSUE
  ADJUSTMENT
  RECEIPT_FG
}

model StockMovement {
  id          String       @id @default(uuid())
  itemId      String
  warehouseId String?
  locationId  String?
  batchId     String?
  type        MovementType

  quantity        Decimal @db.Decimal(12, 2)
  previousBalance Decimal @db.Decimal(12, 2)
  newBalance      Decimal @db.Decimal(12, 2)

  referenceId String?
  reason      String?

  item      Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location  WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batch     InventoryBatch?    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  createdBy String
  createdAt DateTime @default(now())
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  CANCELLED
  EXPIRED
}

model MaterialReservation {
  id              String            @id @default(uuid())
  itemId          String
  warehouseId     String
  productionJobId String
  status          ReservationStatus @default(ACTIVE)

  quantity Decimal @db.Decimal(12, 2)

  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model LowStockAlert {
  id          String      @id @default(uuid())
  itemId      String
  warehouseId String?
  status      AlertStatus @default(ACTIVE)

  shortage Decimal @db.Decimal(12, 2)

  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// 4. MACHINES & MAINTENANCE (FR-02)
// ============================================================================
enum MachineStatus {
  RUNNING
  IDLE
  BREAKDOWN
  MAINTENANCE
}

model Machine {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  type      String // e.g. LOOM, SPINNER, DYE_VAT
  capacity  Decimal       @db.Decimal(10, 2)
  status    MachineStatus @default(IDLE)
  location  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  maintenanceRecords MaintenanceRecord[]
  productionRuns     ProductionRun[]
  capabilities       MachineCapability[]
  ScheduledStage     ScheduledStage[]
}

model MaintenanceRecord {
  id            String   @id @default(uuid())
  machineId     String
  type          String // PREVENTIVE, REPAIR
  description   String
  cost          Decimal  @default(0.00) @db.Decimal(12, 2)
  downtimeHours Decimal  @default(0.00) @db.Decimal(5, 2)
  date          DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 5. WORKFORCE & HR (FR-09)
// ============================================================================
model Employee {
  id         String  @id @default(uuid())
  workerId   String  @unique
  name       String
  role       String // OPERATOR, QC, SUPERVISOR
  hourlyRate Decimal @default(0.00) @db.Decimal(10, 2)
  isActive   Boolean @default(true)

  assignments    WorkerAssignment[]
  inspections    QualityInspection[]
  attendances    Attendance[]
  ScheduledStage ScheduledStage[]
}

model WorkerAssignment {
  id          String  @id @default(uuid())
  employeeId  String
  runId       String
  shift       String // MORNING, EVENING, NIGHT
  hoursWorked Decimal @default(0.00) @db.Decimal(5, 2)

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  productionRun ProductionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 6. PRODUCTION EXECUTION (FR-03, FR-04)
// ============================================================================
enum MOStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ManufacturingOrder {
  id             String   @id @default(uuid())
  orderNumber    String   @unique
  fabricSpec     String
  targetQuantity Decimal  @db.Decimal(12, 2)
  status         MOStatus @default(PLANNED)
  dueDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  runs             ProductionRun[]
  customerOrder    CustomerOrder?     @relation(fields: [customerOrderId], references: [id])
  customerOrderId  String?
  ScheduledStage   ScheduledStage[]
  MaterialShortage MaterialShortage[]
  ProductionBatch  ProductionBatch[]
  ProductionDelay  ProductionDelay[]
}

enum Stage {
  SPINNING
  WEAVING
  DYEING
  FINISHING
}

model ProductionRun {
  id        String    @id @default(uuid())
  orderId   String
  machineId String
  stage     Stage
  startTime DateTime?
  endTime   DateTime?
  status    MOStatus  @default(PLANNED)

  order   ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  machine Machine            @relation(fields: [machineId], references: [id], onDelete: Restrict)

  consumptions      MaterialConsumption[]
  workers           WorkerAssignment[]
  rolls             FabricRoll[]
  ProductionBatch   ProductionBatch?      @relation(fields: [productionBatchId], references: [id])
  productionBatchId String?
  ProductionDelay   ProductionDelay[]
  InspectionRecord  InspectionRecord[]
}

model MaterialConsumption {
  id        String   @id @default(uuid())
  runId     String
  batchId   String
  quantity  Decimal  @db.Decimal(12, 2)
  timestamp DateTime @default(now())

  run   ProductionRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  batch InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
}

// ============================================================================
// 7. QUALITY & FINISHED GOODS (FR-05)
// ============================================================================
enum RollStatus {
  PENDING_INSPECTION
  PASSED
  REWORK
  REJECTED
  DISPATCHED
}

model FabricRoll {
  id         String     @id @default(uuid())
  rollNumber String     @unique
  runId      String
  length     Decimal    @db.Decimal(10, 2)
  weight     Decimal    @db.Decimal(10, 2)
  status     RollStatus @default(PENDING_INSPECTION)
  createdAt  DateTime   @default(now())

  run          ProductionRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  inspections  QualityInspection[]
  dispatchItem DispatchItem?
}

model QualityInspection {
  id          String     @id @default(uuid())
  rollId      String
  inspectorId String
  status      RollStatus
  defectNotes String?
  timestamp   DateTime   @default(now())

  roll      FabricRoll @relation(fields: [rollId], references: [id], onDelete: Cascade)
  inspector Employee   @relation(fields: [inspectorId], references: [id], onDelete: Restrict)
}

// ============================================================================
// 8. SHIPPING & DISPATCH (FR-07)
// ============================================================================
model Customer {
  id              String   @id @default(uuid())
  customerCode    String   @unique @default(cuid())
  name            String
  type            String   @default("STANDARD")
  contactPerson   String?
  email           String?
  phone           String?
  taxRegistration String?
  paymentTerms    String?
  creditLimit     Decimal? @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())

  addresses   CustomerAddress[]
  orders      CustomerOrder[]
  invoices    Invoice[]
  payments    Payment[]
  creditNotes CreditNote[]
}

enum COStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PROCESSING
  PARTIAL
  PARTIALLY_FULFILLED
  FULFILLED
  ON_HOLD
  CANCELLED
  OPEN
}

model CustomerOrder {
  id                    String    @id @default(uuid())
  orderNumber           String    @unique
  customerId            String
  status                COStatus  @default(DRAFT)
  orderDate             DateTime  @default(now())
  requestedDeliveryDate DateTime?
  currency              String    @default("USD")
  subtotal              Decimal   @default(0) @db.Decimal(12, 2)
  discounts             Decimal   @default(0) @db.Decimal(12, 2)
  taxes                 Decimal   @default(0) @db.Decimal(12, 2)
  shippingCharges       Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal   @default(0) @db.Decimal(12, 2)
  priority              String    @default("NORMAL")
  paymentTerms          String?

  approvalById String?

  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines               CustomerOrderLine[]
  manufacturingOrders ManufacturingOrder[]
  dispatches          DispatchRecord[]
  shipments           Shipment[]
  pickLists           PickList[]
  packingRecords      PackingRecord[]
  invoices            Invoice[]
}

model DispatchRecord {
  id            String   @id @default(uuid())
  challanNumber String   @unique
  orderId       String
  dispatchDate  DateTime @default(now())
  vehicleNo     String?

  order CustomerOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items DispatchItem[]
}

model DispatchItem {
  id         String @id @default(uuid())
  dispatchId String
  rollId     String @unique // A roll can only be dispatched once

  dispatch DispatchRecord @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  roll     FabricRoll     @relation(fields: [rollId], references: [id], onDelete: Restrict)
}

// ============================================================================
// 9. FINANCE & COSTING (FR-10)
// ============================================================================
model CostEntry {
  id         String   @id @default(uuid())
  entityType String // e.g. ORDER, MAINTENANCE
  entityId   String
  amount     Decimal  @db.Decimal(12, 2)
  category   String // MATERIAL, LABOUR, OVERHEAD
  timestamp  DateTime @default(now())
}

// ============================================================================
// PHASE 5: ADDITIONAL MODELS
// ============================================================================

model Shift {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  startTime String // e.g., "08:00"
  endTime   String // e.g., "16:00"
  isActive  Boolean @default(true)

  attendances Attendance[]
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  shiftId    String
  date       DateTime  @db.Date
  checkIn    DateTime
  checkOut   DateTime?
  status     String    @default("PRESENT")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([employeeId, shiftId, date])
}

model MachineCapability {
  id         String @id @default(uuid())
  machineId  String
  stage      Stage
  fabricSpec String

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

// ============================================================================
// PHASE 6: PRODUCTION PLANNING & SCHEDULING
// ============================================================================

model ProductionRoute {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  stages ProductionRouteStage[]
}

model ProductionRouteStage {
  id            String  @id @default(uuid())
  routeId       String
  stage         Stage
  sequence      Int
  setupTimeMins Int     @default(0)
  outputUnit    String  @default("kg")
  yieldPercent  Decimal @default(100.00) @db.Decimal(5, 2)

  route ProductionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

model ProductionSchedule {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("PROPOSED")
  createdAt DateTime @default(now())

  stages ScheduledStage[]
}

model ScheduledStage {
  id           String   @id @default(uuid())
  scheduleId   String
  orderId      String
  machineId    String?
  employeeId   String?
  stage        Stage
  plannedStart DateTime
  plannedEnd   DateTime
  status       String   @default("SCHEDULED")

  schedule        ProductionSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  order           ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  machine         Machine?           @relation(fields: [machineId], references: [id])
  employee        Employee?          @relation(fields: [employeeId], references: [id])
  ProductionDelay ProductionDelay[]
}

model MaterialShortage {
  id           String   @id @default(uuid())
  orderId      String
  materialId   String
  requiredQty  Decimal  @db.Decimal(12, 2)
  availableQty Decimal  @db.Decimal(12, 2)
  shortageQty  Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  order    ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material Item               @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// ============================================================================
// PHASE 7: MES (MANUFACTURING EXECUTION SYSTEM)
// ============================================================================

enum RunStatus {
  READY
  IN_PROGRESS
  PAUSED
  BLOCKED
  COMPLETED
  CANCELLED
}

enum DelayType {
  BREAKDOWN
  MATERIAL
  WORKER
  UTILITY
  QUALITY
  DEVIATION
  OTHER
}

model ProductionBatch {
  id           String   @id @default(uuid())
  batchNumber  String   @unique
  orderId      String
  currentStage Stage
  quantity     Decimal  @db.Decimal(12, 2)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  order            ManufacturingOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  runs             ProductionRun[]
  InspectionRecord InspectionRecord[]
  ReworkRecord     ReworkRecord[]
  receipts         FinishedGoodsReceipt[]
}

model ProductionDelay {
  id             String    @id @default(uuid())
  orderId        String
  stageId        String?
  runId          String?
  type           DelayType
  reason         String
  startTime      DateTime  @default(now())
  resolutionTime DateTime?
  reportedById   String
  status         String    @default("OPEN")

  order      ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage      ScheduledStage?    @relation(fields: [stageId], references: [id])
  run        ProductionRun?     @relation(fields: [runId], references: [id])
  reportedBy User               @relation(fields: [reportedById], references: [id])
}

// ============================================================================
// PHASE 8: QUALITY CONTROL AND INSPECTION SYSTEM
// ============================================================================

enum DefectSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum InspectionStatus {
  PENDING_INSPECTION
  IN_PROGRESS
  PASSED
  FAILED
  ON_HOLD
  CANCELLED
}

model QualityStandard {
  id              String   @id @default(uuid())
  name            String
  targetCategory  String? // e.g., 'Yarn', 'Fabric'
  targetStage     String?
  parameter       String
  measurementUnit String
  minVal          Decimal? @db.Decimal(12, 4)
  maxVal          Decimal? @db.Decimal(12, 4)
  targetVal       Decimal? @db.Decimal(12, 4)
  isActive        Boolean  @default(true)
  version         Int      @default(1)

  createdAt DateTime @default(now())

  measurements InspectionMeasurement[]
}

model InspectionPlan {
  id             String  @id @default(uuid())
  name           String
  productProcess String
  samplingMethod String
  sampleSize     Int
  frequency      String?

  createdAt DateTime @default(now())

  records InspectionRecord[]
}

model DefectCatalogue {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  description       String?
  category          String
  severity          DefectSeverity
  recommendedAction String?
  isActive          Boolean        @default(true)

  observedDefects ObservedDefect[]
}

model InspectionRecord {
  id          String  @id @default(uuid())
  type        String
  planId      String?
  batchId     String?
  runId       String?
  receiptId   String?
  inspectorId String?

  status            InspectionStatus @default(PENDING_INSPECTION)
  startTime         DateTime?
  completionTime    DateTime?
  overallOutcome    String? // e.g., 'PASSED', 'FAILED', 'ON_HOLD'
  inspectorComments String?

  createdAt DateTime @default(now())

  plan      InspectionPlan?  @relation(fields: [planId], references: [id])
  batch     ProductionBatch? @relation(fields: [batchId], references: [id])
  run       ProductionRun?   @relation(fields: [runId], references: [id])
  receipt   GoodsReceipt?    @relation(fields: [receiptId], references: [id])
  inspector User?            @relation(fields: [inspectorId], references: [id])

  measurements InspectionMeasurement[]
  defects      ObservedDefect[]
  reworks      ReworkRecord[]
}

model InspectionMeasurement {
  id               String   @id @default(uuid())
  recordId         String
  standardId       String
  recordedValue    Decimal? @db.Decimal(12, 4)
  categoricalValue String?
  isPassed         Boolean

  record   InspectionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  standard QualityStandard  @relation(fields: [standardId], references: [id])
}

model ObservedDefect {
  id             String  @id @default(uuid())
  recordId       String
  defectId       String
  quantity       Int     @default(1)
  location       String?
  inspectorNotes String?
  disposition    String?

  record InspectionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  defect DefectCatalogue  @relation(fields: [defectId], references: [id])
}

model ReworkRecord {
  id              String    @id @default(uuid())
  inspectionId    String
  batchId         String
  instructions    String
  assignedToId    String?
  plannedQuantity Decimal   @db.Decimal(12, 2)
  actualQuantity  Decimal?  @db.Decimal(12, 2)
  status          String    @default("PENDING")
  startTime       DateTime?
  completionTime  DateTime?

  inspection InspectionRecord @relation(fields: [inspectionId], references: [id])
  batch      ProductionBatch  @relation(fields: [batchId], references: [id])
  assignedTo User?            @relation(fields: [assignedToId], references: [id])
}

model CAPARecord {
  id                 String    @id @default(uuid())
  problemDescription String
  rootCauseCategory  String?
  rootCauseNotes     String?
  correctiveAction   String?
  preventiveAction   String?
  assignedToId       String?
  dueDate            DateTime?
  status             String    @default("OPEN")
  createdAt          DateTime  @default(now())

  assignedTo User? @relation(fields: [assignedToId], references: [id])
}

// ============================================================================
// PHASE 9: FINISHED GOODS, WAREHOUSE, & INVENTORY MGMT
// ============================================================================

model WarehouseLocation {
  id          String   @id @default(uuid())
  warehouseId String
  code        String   @unique // e.g. ZONE-A-RACK-01
  type        String // e.g. RACK, BIN, ZONE
  capacity    Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  balances  InventoryBalance[]
  movements StockMovement[]
}

model FinishedGoodsReceipt {
  id            String   @id @default(uuid())
  receiptNumber String   @unique
  batchId       String
  itemId        String
  warehouseId   String
  locationId    String?
  quantity      Decimal  @db.Decimal(12, 2)
  status        String   @default("COMPLETED")
  remarks       String?
  receivedById  String
  createdAt     DateTime @default(now())

  batch      ProductionBatch @relation(fields: [batchId], references: [id])
  item       Item            @relation(fields: [itemId], references: [id])
  warehouse  Warehouse       @relation(fields: [warehouseId], references: [id])
  receivedBy User            @relation(fields: [receivedById], references: [id])
}

model WarehouseTransfer {
  id            String    @id @default(uuid())
  itemId        String
  batchId       String?
  sourceWhId    String
  sourceLocId   String?
  destWhId      String
  destLocId     String?
  requestedQty  Decimal   @db.Decimal(12, 2)
  shippedQty    Decimal?  @db.Decimal(12, 2)
  receivedQty   Decimal?  @db.Decimal(12, 2)
  status        String    @default("REQUESTED") // REQUESTED, APPROVED, IN_TRANSIT, RECEIVED, CANCELLED
  reason        String?
  requestedById String
  createdAt     DateTime  @default(now())
  dispatchedAt  DateTime?
  receivedAt    DateTime?

  item        Item            @relation(fields: [itemId], references: [id])
  batch       InventoryBatch? @relation(fields: [batchId], references: [id])
  sourceWh    Warehouse       @relation("SourceWh", fields: [sourceWhId], references: [id])
  destWh      Warehouse       @relation("DestWh", fields: [destWhId], references: [id])
  requestedBy User            @relation(fields: [requestedById], references: [id])
}

model StockCount {
  id          String    @id @default(uuid())
  warehouseId String
  status      String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  createdBy   String
  createdAt   DateTime  @default(now())
  approvedBy  String?
  approvedAt  DateTime?

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  creator   User      @relation("CountCreator", fields: [createdBy], references: [id])
  approver  User?     @relation("CountApprover", fields: [approvedBy], references: [id])

  items StockCountItem[]
}

model StockCountItem {
  id          String  @id @default(uuid())
  countId     String
  itemId      String
  batchId     String?
  locationId  String?
  systemQty   Decimal @db.Decimal(12, 2)
  physicalQty Decimal @db.Decimal(12, 2)
  varianceQty Decimal @db.Decimal(12, 2)
  reasonCode  String?

  count StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  item  Item       @relation(fields: [itemId], references: [id])
}

model FinishedGoodsReservation {
  id        String   @id @default(uuid())
  orderId   String // e.g. Customer Order ID
  itemId    String
  batchId   String?
  quantity  Decimal  @db.Decimal(12, 2)
  status    String   @default("RESERVED") // RESERVED, CONSUMED, RELEASED
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])
}

// ============================================================================
// PHASE 10: SALES ORDERS, FULFILLMENT, DISPATCH
// ============================================================================

model CustomerAddress {
  id          String  @id @default(uuid())
  customerId  String
  type        String  @default("SHIPPING") // BILLING, SHIPPING
  addressLine String
  city        String?
  state       String?
  zipCode     String?
  country     String?
  isDefault   Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerOrderLine {
  id             String  @id @default(uuid())
  orderId        String
  itemId         String
  quantity       Decimal @db.Decimal(12, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  specifications Json?
  fulfilledQty   Decimal @default(0) @db.Decimal(12, 2)
  reservedQty    Decimal @default(0) @db.Decimal(12, 2)

  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item          @relation(fields: [itemId], references: [id])
}

model PickList {
  id             String   @id @default(uuid())
  pickListNumber String   @unique
  orderId        String
  status         String   @default("CREATED") // CREATED, IN_PROGRESS, COMPLETED
  assignedToId   String?
  remarks        String?
  createdAt      DateTime @default(now())

  order      CustomerOrder  @relation(fields: [orderId], references: [id])
  assignedTo User?          @relation("PickListAssignee", fields: [assignedToId], references: [id])
  items      PickListItem[]
}

model PickListItem {
  id          String  @id @default(uuid())
  pickListId  String
  itemId      String
  batchId     String?
  locationId  String?
  requiredQty Decimal @db.Decimal(12, 2)
  pickedQty   Decimal @default(0) @db.Decimal(12, 2)

  pickList PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])
}

model PackingRecord {
  id           String   @id @default(uuid())
  packingRef   String   @unique
  orderId      String
  packageCount Int      @default(1)
  notes        String?
  packedById   String
  createdAt    DateTime @default(now())

  order    CustomerOrder @relation(fields: [orderId], references: [id])
  packedBy User          @relation("PackingOperator", fields: [packedById], references: [id])
}

model Shipment {
  id              String    @id @default(uuid())
  shipmentNumber  String    @unique
  orderId         String
  carrier         String?
  trackingNumber  String?
  status          String    @default("PREPARED") // PREPARED, READY_FOR_DISPATCH, DISPATCHED, IN_TRANSIT, DELIVERED, EXCEPTION
  dispatchDate    DateTime?
  expectedDelDate DateTime?
  actualDelDate   DateTime?
  operatorId      String?
  notes           String?
  createdAt       DateTime  @default(now())

  order    CustomerOrder   @relation(fields: [orderId], references: [id])
  operator User?           @relation("ShipmentOperator", fields: [operatorId], references: [id])
  events   ShipmentEvent[]
  invoices Invoice[]
}

model ShipmentEvent {
  id         String   @id @default(uuid())
  shipmentId String
  eventType  String
  location   String?
  notes      String?
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

// ============================================================================
// PHASE 11: INVOICING, PAYMENTS & FINANCIAL MANAGEMENT
// ============================================================================

model TaxConfiguration {
  id            String    @id @default(uuid())
  category      String // e.g. GST, VAT
  rate          Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  customerId    String
  orderId       String?
  shipmentId    String?
  issueDate     DateTime?
  dueDate       DateTime?
  currency      String    @default("USD")

  subtotal        Decimal @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal @default(0) @db.Decimal(12, 2)
  shippingCharges Decimal @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal @default(0) @db.Decimal(12, 2)
  amountPaid      Decimal @default(0) @db.Decimal(12, 2)

  status String @default("DRAFT") // DRAFT, APPROVED, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, VOID

  createdById  String
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  order    CustomerOrder? @relation(fields: [orderId], references: [id])
  shipment Shipment?      @relation(fields: [shipmentId], references: [id])

  createdBy  User  @relation("InvoiceCreator", fields: [createdById], references: [id])
  approvedBy User? @relation("InvoiceApprover", fields: [approvedById], references: [id])

  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  itemId    String
  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id])
}

model Payment {
  id                String   @id @default(uuid())
  paymentReference  String   @unique
  customerId        String
  amount            Decimal  @db.Decimal(12, 2)
  unallocatedAmount Decimal  @db.Decimal(12, 2)
  currency          String   @default("USD")
  method            String // BANK, CARD, CASH
  transactionRef    String?
  status            String   @default("RECORDED") // RECORDED, ALLOCATED, REVERSED
  paymentDate       DateTime @default(now())

  recordedById String
  notes        String?

  customer   Customer @relation(fields: [customerId], references: [id])
  recordedBy User     @relation("PaymentRecorder", fields: [recordedById], references: [id])

  allocations PaymentAllocation[]
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String
  invoiceId       String
  allocatedAmount Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
}

model CreditNote {
  id               String  @id @default(uuid())
  creditNoteNumber String  @unique
  invoiceId        String
  customerId       String
  amount           Decimal @db.Decimal(12, 2)
  reason           String
  status           String  @default("DRAFT") // DRAFT, APPROVED, ISSUED

  createdById  String
  approvedById String?
  createdAt    DateTime @default(now())

  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  createdBy  User     @relation("CreditCreator", fields: [createdById], references: [id])
  approvedBy User?    @relation("CreditApprover", fields: [approvedById], references: [id])
}

model SupplierInvoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  supplierId    String
  poId          String?
  amount        Decimal   @db.Decimal(12, 2)
  taxAmount     Decimal   @default(0) @db.Decimal(12, 2)
  status        String    @default("PENDING") // PENDING, APPROVED, PAID
  dueDate       DateTime?

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id])
}

// ============================================================================
// PHASE 12: NOTIFICATIONS, ALERTS & WORKFLOW AUTOMATION
// ============================================================================

model NotificationEvent {
  id        String   @id @default(uuid())
  eventType String // e.g. 'inventory.low_stock'
  payload   Json // Event data
  status    String   @default("PENDING") // PENDING, PROCESSED, FAILED
  errorMsg  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationRule {
  id        String   @id @default(uuid())
  name      String
  eventType String
  roles     Json // Array of role names
  channels  Json // Array of channels e.g. ["IN_APP", "EMAIL"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id                String   @id @default(uuid())
  userId            String
  eventId           String?
  title             String
  body              String
  type              String // INFO, WARNING, ERROR, SUCCESS
  relatedEntityId   String?
  relatedEntityType String?
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id])
}

model NotificationDelivery {
  id             String   @id @default(uuid())
  notificationId String
  channel        String // EMAIL
  recipient      String // Email address
  status         String   @default("PENDING") // PENDING, SENT, FAILED
  retryCount     Int      @default(0)
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model NotificationPreference {
  id           String  @id @default(uuid())
  userId       String  @unique
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)

  user User @relation("UserNotificationPreferences", fields: [userId], references: [id])
}
