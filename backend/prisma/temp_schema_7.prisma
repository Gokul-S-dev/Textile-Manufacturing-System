
// ============================================================================
// PHASE 7: MES (MANUFACTURING EXECUTION SYSTEM)
// ============================================================================

enum RunStatus {
  READY
  IN_PROGRESS
  PAUSED
  BLOCKED
  COMPLETED
  CANCELLED
}

enum DelayType {
  BREAKDOWN
  MATERIAL
  WORKER
  UTILITY
  QUALITY
  DEVIATION
  OTHER
}

model ProductionBatch {
  id            String   @id @default(uuid())
  batchNumber   String   @unique
  orderId       String
  currentStage  Stage
  quantity      Decimal  @db.Decimal(12, 2)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  
  order         ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  runs          ProductionRun[]
}

model ProductionDelay {
  id            String    @id @default(uuid())
  orderId       String
  stageId       String?
  runId         String?
  type          DelayType
  reason        String
  startTime     DateTime  @default(now())
  resolutionTime DateTime?
  reportedById  String
  status        String    @default("OPEN")

  order         ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage         ScheduledStage?    @relation(fields: [stageId], references: [id])
  run           ProductionRun?     @relation(fields: [runId], references: [id])
  reportedBy    User               @relation(fields: [reportedById], references: [id])
}
